# Use official lightweight Node.js 22 LTS image
FROM node:22-slim

# Set environment variables
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    DANGEROUSLY_BIND_ALL_INTERFACES=true \
    DANGEROUSLY_OMIT_AUTH=true \
    MCP_INSPECTOR_SECRET_STORE=memory \
    ALLOWED_ORIGINS=https://v-lkg-inspector-826803329504.us-central1.run.app,https://v-lkg-inspector-cgwpuv3gna-uc.a.run.app,http://localhost:8080,http://127.0.0.1:8080,http://localhost:6274,http://127.0.0.1:6274

# Install the modern v2 inspector globally
RUN npm install -g @modelcontextprotocol/inspector@2.4.0

# Expose port
EXPOSE 8080

# Run the inspector with CLIENT_PORT dynamically set to Cloud Run's $PORT
CMD ["sh", "-c", "CLIENT_PORT=${PORT:-8080} mcp-inspector --web"]
